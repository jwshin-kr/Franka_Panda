                  <body name="link7" pos="0.088 0 0" quat="1 1 0 0">
                    <inertial pos="0.00452258 0.00862619 -0.0161633" quat="0.727579 0.0978688 -0.24906 0.63168"
                      mass="0.627143" diaginertia="0.000223836 0.000223642 5.64132e-07"/>
                    <joint name="joint7" axis="0 0 1" range="-3.0159 3.0159" actuatorfrcrange="-12 12"
                      armature="0.074" frictionloss="0.248"/>
                    <geom mesh="link7_0" material="black" class="no_contact"/>
                    <geom mesh="link7_1" material="white" class="no_contact"/>
                    <geom mesh="link7_2" material="white" class="no_contact"/>
                    <geom mesh="link7_3" material="black" class="no_contact"/>
                    <geom class="contact" mesh="link7_coll"/>

                    <!-- Flange frame (massless, = franka_description fr3_link8). -->
                    <body name="flange" pos="0 0 0.107">
                      <!-- Robotiq 2F-85, DROID mount: not turned about the flange z
                           axis, so the fingers close along the flange y axis and
                           approach along its z axis. CHECK on your rig: if the
                           coupling is mounted at another angle, change this quat and
                           rerun urdf/make_fr3_robotiq_urdf.py. -->
                      <body name="gripper" childclass="robotiq">
                        <!-- Tool centre point between the pad faces at a ~55 mm opening
                             (the pads ride on an arc: 8 mm lower fully open, 5 mm
                             higher closed). Massless. -->
                        <body name="tcp" pos="0 0 0.15"/>
                        <!-- Coupling turned +90 deg so the 2F-85's closing axis (its
                             base y after the base's own -90 deg) is the flange y. -->
                        <body name="robotiq_base_mount" pos="0 0 0.007" quat="0.7071068 0 0 0.7071068">
                          <!-- Coupling; mass so the whole gripper is 0.925 kg. -->
                          <inertial mass="0.025" pos="0 0 0.004" diaginertia="2e-5 2e-5 3e-5"/>
                          <geom class="robotiq_visual" mesh="robotiq_base_mount" material="robotiq_black"/>
                          <geom class="robotiq_collision" mesh="robotiq_base_mount"/>
                          <body name="robotiq_base" pos="0 0 0.0038" quat="1 0 0 -1">
                            <inertial mass="0.777441" pos="0 -2.70394e-05 0.0354675" quat="1 -0.00152849 0 0"
                              diaginertia="0.000260285 0.000225381 0.000152708"/>
                            <geom class="robotiq_visual" mesh="robotiq_base" material="robotiq_black"/>
                            <geom class="robotiq_collision" mesh="robotiq_base"/>
