                                quat="0.681301 0.732003 0 0" diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                              <joint name="robotiq_right_driver_joint" class="robotiq_driver"/>
                              <geom class="robotiq_visual" mesh="robotiq_driver" material="robotiq_gray"/>
                              <geom class="robotiq_collision" mesh="robotiq_driver"/>
                              <body name="robotiq_right_coupler" pos="0 0.0315 -0.0041">
                                <inertial mass="0.0140974" pos="0 0.00301209 0.0232175"
                                  quat="0.705636 -0.0455904 0.0455904 0.705636"
                                  diaginertia="4.16206e-06 3.52216e-06 8.88131e-07"/>
                                <joint name="robotiq_right_coupler_joint" class="robotiq_coupler"/>
                                <geom class="robotiq_visual" mesh="robotiq_coupler" material="robotiq_black"/>
                                <geom class="robotiq_collision" mesh="robotiq_coupler"/>
                              </body>
                            </body>
                            <body name="robotiq_right_spring_link" pos="0 0.0132 0.0609">
                              <inertial mass="0.0221642" pos="-8.65005e-09 0.0181624 0.0212658"
                                quat="0.663403 -0.244737 0.244737 0.663403"
                                diaginertia="8.96853e-06 6.71733e-06 2.63931e-06"/>
                              <joint name="robotiq_right_spring_link_joint" class="robotiq_spring_link"/>
                              <geom class="robotiq_visual" mesh="robotiq_spring_link" material="robotiq_black"/>
                              <geom class="robotiq_collision" mesh="robotiq_spring_link"/>
                              <body name="robotiq_right_follower" pos="0 0.055 0.0375">
                                <inertial mass="0.0125222" pos="0 -0.011046 0.0124786" quat="1 0.1664 0 0"
                                  diaginertia="2.67415e-06 2.4559e-06 6.02031e-07"/>
                                <joint name="robotiq_right_follower_joint" class="robotiq_follower"/>
                                <geom class="robotiq_visual" mesh="robotiq_follower" material="robotiq_black"/>
                                <geom class="robotiq_collision" mesh="robotiq_follower"/>
                                <body name="robotiq_right_pad" pos="0 -0.0189 0.01352">
                                  <inertial mass="0.0035" pos="0 -0.0025 0.0185" quat="0.707107 0 0 0.707107"
                                    diaginertia="4.73958e-07 3.64583e-07 1.23958e-07"/>
                                  <geom class="robotiq_pad_box1" name="robotiq_right_pad1"/>
                                  <geom class="robotiq_pad_box2" name="robotiq_right_pad2"/>
                                  <geom class="robotiq_visual" mesh="robotiq_pad"/>
                                  <geom class="robotiq_visual" mesh="robotiq_silicone_pad" material="robotiq_black"/>
                                  <!-- Centre of the pad's gripping face. -->
                                  <site name="robotiq_right_pad_face" pos="0 -0.0066 0.01875" size="0.002"
                                    rgba="0 1 0 0.5" group="4"/>
                                </body>
                              </body>
                            </body>
                            <!-- Left four-bar linkage -->
                            <body name="robotiq_left_driver" pos="0 -0.0306011 0.054904" quat="0 0 0 1">
                              <inertial mass="0.00899563" pos="0 0.0177547 0.00107314" quat="0.681301 0.732003 0 0"
                                diaginertia="1.72352e-06 1.60906e-06 3.22006e-07"/>
                              <joint name="robotiq_left_driver_joint" class="robotiq_driver"/>
