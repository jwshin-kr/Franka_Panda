<mujoco model="franka_fr3">
  <!-- Franka Research 3: 7-DoF arm + Robotiq 2F-85 gripper (the DROID setup).

       Arm: MuJoCo Menagerie franka_fr3/fr3.xml (Apache-2.0, see fr3/LICENSE),
       derived from franka_description. Kinematics, inertial parameters, joint
       armature / damping / frictionloss, FR3 joint ranges and meshes are
       unchanged. Gripper: MuJoCo Menagerie robotiq_2f85 (BSD-2-Clause, see
       robotiq/LICENSE). Edits:
         - link / joint names without the "fr3_" prefix (link0..link7,
           joint1..joint7), mesh paths point into fr3/ and robotiq/,
         - no arm actuators here: like Rizon4_hand_robot.xml, the scene file
           adds one torque motor per arm joint (and the gripper actuator),
         - geom classes follow the Rizon4 model: "no_contact" (visual) and
           "contact" (collision, same contact parameters as Rizon4). Collision
           geoms are in group 4 so they stay hidden by default (enable geom
           group 4 in the MuJoCo viewer to show them),
         - massless frames: flange (= franka_description fr3_link8), gripper
           (the 2F-85 on the flange, DROID mount: not turned about z, so the
           fingers close along the flange y axis) and tcp (between the pads,
           0.15 m along the flange z axis),
         - the 2F-85 keeps the Menagerie closed four-bar linkage (equality
           constraints) and its single position-servo drive on the two driver
           joints. The one gripper DoF is robotiq_right_driver_joint
           (0 = open .. 0.8 rad = closed), like the real gripper, which takes
           a position (0..255) only. Bodies / joints are prefixed "robotiq_",
           masses sum to 0.925 kg (datasheet, incl. coupling).

       urdf/fr3_robotiq.urdf (Pinocchio, gripper linkage frozen open) and
       urdf/fr3_robotiq_viser.urdf (Viser, linkage via <mimic>) are written
       from this file by urdf/make_fr3_robotiq_urdf.py. Rerun it after an
       edit here. -->
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="fr3">
      <!-- Menagerie FR3 joint dynamics; overwritten in joints 5, 6 and 7. -->
      <joint damping="0.21" armature="0.195" frictionloss="1.137"/>
      <!-- Geoms are massless (density=0, as in Rizon4_hand_robot.xml): every
           robot body has an explicit <inertial>, and the static enclosure
           (which uses no_contact) should not get a mesh-volume mass. -->
      <!-- Visual-only geoms (no collision). -->
      <default class="no_contact">
        <geom type="mesh" conaffinity="0" contype="0" group="1" density="0"/>
      </default>
      <!-- Collision geoms. -->
      <default class="contact">
        <geom type="mesh" conaffinity="1" contype="1" condim="6" priority="1" group="4" density="0"
              friction="1.0 0.02 0.0001" solimp="0.95 0.99 0.001 0.5 2" solref="0.005 1"/>
      </default>
    </default>

    <!-- Robotiq 2F-85 (Menagerie robotiq_2f85 classes). -->
    <default class="robotiq">
      <mesh scale="0.001 0.001 0.001"/>
      <general biastype="affine"/>
      <joint axis="1 0 0"/>
      <default class="robotiq_driver">
        <joint range="0 0.8" armature="0.005" damping="0.1" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_follower">
        <joint range="-0.872664 0.872664" armature="0.001" pos="0 -0.018 0.0065" solimplimit="0.95 0.99 0.001"
          solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_spring_link">
        <joint range="-0.29670597283 0.8" armature="0.001" stiffness="0.05" springref="2.62" damping="0.00125"/>
      </default>
      <default class="robotiq_coupler">
        <joint range="-1.57 0" armature="0.001" solimplimit="0.95 0.99 0.001" solreflimit="0.005 1"/>
      </default>
      <default class="robotiq_visual">
        <geom type="mesh" contype="0" conaffinity="0" group="1" density="0"/>
      </default>
      <default class="robotiq_collision">
        <geom type="mesh" group="4" density="0"/>
        <!-- Finger pads (Menagerie friction). -->
        <default class="robotiq_pad_box1">
          <geom type="box" pos="0 -0.0026 0.028125" size="0.011 0.004 0.009375"
            friction="0.7" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.55 0.55 0.55 1"/>
        </default>
        <default class="robotiq_pad_box2">
          <geom type="box" pos="0 -0.0026 0.009375" size="0.011 0.004 0.009375"
            friction="0.6" solimp="0.95 0.99 0.001" solref="0.004 1" priority="1" rgba="0.45 0.45 0.45 1"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material name="black" rgba=".2 .2 .2 1"/>
    <material name="white" rgba="1 1 1 1"/>
    <material name="red" rgba="1 0.072272 0.039546 1"/>
