<mujoco model="franka_panda">
  <!-- Franka Emika Panda: 7-DoF arm + Franka Hand (2 prismatic fingers).

       Derived from MuJoCo Menagerie franka_emika_panda/panda.xml (Apache-2.0,
       see panda/LICENSE). Kinematics, inertial parameters (franka_description
       inertial.yaml), joint armature/damping and meshes are unchanged. Edits:
         - mesh paths point into panda/visual and panda/collision,
         - no actuators / tendon / equality here: like Rizon4_hand_robot.xml,
           the scene file adds one torque motor per joint, so the two fingers
           are two independent joints,
         - geom classes follow the Rizon4 model: "no_contact" (visual) and
           "contact" (collision, same contact parameters as Rizon4). Collision
           geoms are in group 4 so they stay hidden by default (enable geom
           group 4 in the MuJoCo viewer to show them),
         - added massless frames: flange (= franka_description panda_link8) and
           tcp (Franka Hand default TCP, 0.1034 m along the hand z axis).

       urdf/panda_viser.urdf mirrors this file 1:1 (names, kinematics,
       inertias) so Pinocchio's g(q) equals MuJoCo's. Keep the two in sync. -->
  <compiler angle="radian" autolimits="true"/>

  <default>
    <default class="panda">
      <material specular="0.5" shininess="0.25"/>
      <joint armature="0.1" damping="1" axis="0 0 1" range="-2.8973 2.8973"/>
      <default class="finger">
        <joint axis="0 1 0" type="slide" range="0 0.04"/>
      </default>

      <!-- Geoms are massless (density=0, as in Rizon4_hand_robot.xml): every
           robot body has an explicit <inertial>, and the static enclosure
           (which uses no_contact) should not get a mesh-volume mass. -->
      <!-- Visual-only geoms (no collision). -->
      <default class="no_contact">
        <geom type="mesh" conaffinity="0" contype="0" group="1" density="0"/>
      </default>
      <!-- Collision geoms. -->
      <default class="contact">
        <geom type="mesh" conaffinity="1" contype="1" condim="6" priority="1" group="4" density="0"
              friction="1.0 0.02 0.0001" solimp="0.95 0.99 0.001 0.5 2" solref="0.005 1"/>
        <default class="fingertip_pad_collision_1">
          <geom type="box" size="0.0085 0.004 0.0085" pos="0 0.0055 0.0445"/>
        </default>
        <default class="fingertip_pad_collision_2">
          <geom type="box" size="0.003 0.002 0.003" pos="0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_3">
          <geom type="box" size="0.003 0.002 0.003" pos="-0.0055 0.002 0.05"/>
        </default>
        <default class="fingertip_pad_collision_4">
          <geom type="box" size="0.003 0.002 0.0035" pos="0.0055 0.002 0.0395"/>
        </default>
        <default class="fingertip_pad_collision_5">
          <geom type="box" size="0.003 0.002 0.0035" pos="-0.0055 0.002 0.0395"/>
        </default>
      </default>
    </default>
  </default>

  <asset>
    <material class="panda" name="white" rgba="1 1 1 1"/>
    <material class="panda" name="off_white" rgba="0.901961 0.921569 0.929412 1"/>
    <material class="panda" name="black" rgba="0.25 0.25 0.25 1"/>
    <material class="panda" name="green" rgba="0 1 0 1"/>
    <material class="panda" name="light_blue" rgba="0.039216 0.541176 0.780392 1"/>

    <!-- Collision meshes -->
    <mesh name="link0_c" file="panda/collision/link0.stl"/>
